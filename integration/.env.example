# Copy to .env (or .env.staging / .env.local) and fill secrets.
# Select profile with FW_ENV=local|staging|prod (default: staging).

# Optional overrides (defaults come from helpers/env.ts):
# FW_BASE_URL=https://staging.fileworks.ai
# FW_API_URL=https://api.staging.fileworks.ai

# Required for POST /api/v1/convert and full convert coverage:
FW_API_KEY=fw_live_your_key_here

# Optional: Playwright storage state for signed-in workspace UI convert tests.
# Create once with: npx playwright codegen --save-storage=.auth/user.json <base-url>
# FW_STORAGE_STATE=.auth/user.json

# Timeouts (ms) for slow convert calls on cold Lambda
# FW_CONVERT_TIMEOUT_MS=180000
