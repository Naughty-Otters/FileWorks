{
  "name": "fileworks-integration",
  "version": "0.1.0",
  "private": true,
  "description": "Post-deploy UI + API integration tests for FileWorks",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:staging": "FW_ENV=staging playwright test",
    "test:local": "FW_ENV=local playwright test",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^20.19.0",
    "dotenv": "^16.6.1",
    "typescript": "^5.9.2"
  }
}
