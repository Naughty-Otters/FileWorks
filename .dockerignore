# Backend image is built from repo root; keep the context small so Compose /
# BuildKit can reuse layers instead of re-uploading the whole monorepo.
.git
.github
.cursor
.terraform
**/.terraform
**/*.tfstate
**/*.tfstate.*

**/__pycache__
**/*.pyc
**/.venv
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.paddlex

**/.env
**/.env.*
backend/uploads
backend/data
backend/vendor
backend/secrets
backend/tests

frontend
fw
docs
scripts
agent-transcripts

infra/terraform
# Exclude markdown docs from the image context. Do NOT store runtime prompts as
# .md under backend/app — Docker will drop them and the API crashes on boot.
# Put prompts in Python modules (see app/processing/template/prompts/).
**/*.md
!backend/README.md
