# Backend image is built from repo root; keep the context small so Compose /
# BuildKit can reuse layers instead of re-uploading the whole monorepo.
.git
.github
.cursor
.terraform
**/.terraform
**/*.tfstate
**/*.tfstate.*

**/__pycache__
**/*.pyc
**/.venv
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.paddlex

**/.env
**/.env.*
backend/uploads
backend/data
backend/vendor
backend/secrets
backend/tests

frontend
fw
docs
scripts
agent-transcripts

infra/terraform
**/*.md
!backend/README.md
