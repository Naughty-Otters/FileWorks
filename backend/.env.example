PADDLE_DEVICE=cpu
# In-process Paddle OCR/Structure. Off until the dedicated Paddle box is retired.
# Set true to put OCRReader + LiteParse's Paddle deep chain back in the pipeline.
PADDLE_OCR_ENABLED=false
# Pipeline spec — enable/disable stages and readers. See GET /api/v1/convert → pipeline.
# TEXT_READER_ENABLED=true
# DOCLING_ENABLED=true
# ANYDOC_ENABLED=true
# LLM_READER_ENABLED=true
# PIPELINE_PREPARE_OCR_ENABLED=true
# PIPELINE_MEDIA_ENABLED=true
# PIPELINE_STRUCTURE_EDIT_ENABLED=true
# PIPELINE_TRANSLATE_ENABLED=true
# PIPELINE_NORMALIZE_ENABLED=true
# PIPELINE_FILL_ENABLED=true
# PIPELINE_PROJECT_ENABLED=true
# Warmup / legacy OCRService default provider: structure | ocr
# Uploads use readers: AnyDoc → LLM (if configured) → OCR (PP-OCR → Structure)
OCR_ENGINE=ocr
# OCR input prep: long-edge cap before Paddle (default ~150 dpi A4 / high ~300 dpi A4)
# OCR_MAX_INPUT_SIDE_DEFAULT=1754
# OCR_MAX_INPUT_SIDE_HIGH=2480
# Docker on Apple Silicon: Paddle segfaults above ~1296 px — set platform cap:
# OCR_PLATFORM_MAX_INPUT_SIDE=1200
# Readers: uv sync --all-extras (same extras as the Lambda/Compose image)
# OCR is server-selected via processing.strategy (see strategy/README.md)
# LITEPARSE_ENABLED=true
# LITEPARSE_DPI=150
# LITEPARSE_USE_PADDLE_OCR=true
# Only set LITEPARSE_OCR_SERVER_URL for an external OCR service (skips auto routing)
# LiteParse OCR callbacks — default local; set for external microservices later
# OCR_FAST_SERVER_URL=http://127.0.0.1:8000/api/ocr/fast
# OCR_DEEP_SERVER_URL=http://127.0.0.1:8000/api/ocr/deep
# OCR_UNIFIED_SERVER_URL=http://127.0.0.1:8000/api/ocr
# LITEPARSE_OCR_SERVER_URL=  # legacy alias for OCR_UNIFIED_SERVER_URL (single external OCR)
# EASYOCR_ENABLED=true
# EASYOCR_USE_GPU=false
# EASYOCR_OCR_SERVER_URL=  # legacy alias for OCR_FAST_SERVER_URL
# SURYA_ENABLED=false
MAX_UPLOAD_MB=50

# LLM engine (optional). Inactive until LLM_PROVIDER + API key are set.
# Providers: openrouter | fireworks | deepseek | kimi | glm | openai | grok | claude | gemini
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# LLM_PRIORITY=30
# LLM_PRIORITY_FALLBACK=95
# LLM_MAX_PAGES=8
# LLM_API_KEY=
#
# Endpoint (OpenAI-compatible). ChatOpenAI posts to {base}/chat/completions.
# Hosted https://api.deepseek.com/chat/completions is text-only — not for file/vision OCR.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_ENDPOINT=http://127.0.0.1:8000/v1/chat/completions
# DEEPSEEK_BASE_URL=http://127.0.0.1:8000/v1
# OPENROUTER_BASE_URL=
# OPENAI_BASE_URL=
#
# OPENROUTER_API_KEY=
# FIREWORKS_API_KEY=
# DEEPSEEK_API_KEY=
# KIMI_API_KEY=
# MOONSHOT_API_KEY=
# GLM_API_KEY=
# ZHIPU_API_KEY=
# OPENAI_API_KEY=
# GROK_API_KEY=
# XAI_API_KEY=
# ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Translation post-process (optional, separate from vision LLM_PROVIDER).
# Text-only models are fine (hosted DeepSeek works here).
# TRANSLATE_API_KEY must be a raw key for TRANSLATE_PROVIDER — do not paste
# LLM_API_KEY=... or an OpenAI sk-svcacct / sk-proj key into a DeepSeek slot.
# TRANSLATE_PROVIDER=deepseek
# TRANSLATE_MODEL=deepseek-v4-flash
# TRANSLATE_API_KEY=
# TRANSLATE_BASE_URL=
# TRANSLATE_ENDPOINT=

# Document history: local now, switch to s3 later
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/history
# S3_BUCKET=
# S3_PREFIX=history
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=
# Browser uploads: s3://fileworks-<prod|stage|dev>/upload/files/<user_id>/<file>
# S3_UPLOAD_BUCKET=
# S3_UPLOAD_PREFIX=upload/files

# Auth (Docker Compose / local Postgres)
# DATABASE_URL=postgresql+psycopg://fileworks:fileworks@127.0.0.1:5432/fileworks
# JWT_SECRET=change-me
# Public GIS client ID (not the OAuth client secret). Add Authorized JavaScript
# origins for http://localhost:3000 and https://fileworks-<env>.pages.dev
# GOOGLE_CLIENT_ID=
# ACCESS_TOKEN_TTL_S=3600
# REFRESH_TOKEN_TTL_DAYS=30
# Schema: uv run python -m app.db.upgrade  (also runs on API boot)
# AWS only: sibling Lambda for vision LLM + translation (no NAT)
# LLM_LAMBDA_FUNCTION=

# Stripe (optional). Sandbox needs only the secret key (sk_test_...).
# The publishable key (pk_test_...) is unused — Checkout is created on the API.
# A webhook secret is optional locally: after Checkout, /pricing and /profile
# confirm the session with session_id. Add a webhook later for cancels/renewals.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_BASIC=0
# STRIPE_PRICE_PRO=5
# STRIPE_PRICE_PREMIUM=29
# STRIPE_PRICE_API_BUILDER=5
# STRIPE_PRICE_API_SCALE=29
# STRIPE_PRICE_API_BUSINESS=99
# Optional yearly Stripe prices (price_… id or USD). When unset, yearly = 30% off 12× monthly.
# STRIPE_PRICE_PRO_YEARLY=42
# STRIPE_PRICE_PREMIUM_YEARLY=244
# STRIPE_PRICE_API_BUILDER_YEARLY=42
# STRIPE_PRICE_API_SCALE_YEARLY=244
# STRIPE_PRICE_API_BUSINESS_YEARLY=832
# STRIPE_TAX_CODE=txcd_10103000
# PUBLIC_APP_URL=http://localhost:3000
#
# Per-env AWS secrets: `fw --env <env> seed-secrets` loads this file, then
# overlays backend/.env.<env> if it exists (not committed). Put the live
# Stripe key and site URL in backend/.env.prod — seeding a sk_test_ key
# or localhost PUBLIC_APP_URL into prod is refused.
#   backend/.env.staging  STRIPE_SECRET_KEY=sk_test_...
#                         PUBLIC_APP_URL=https://fileworks-staging.pages.dev
#                         PUBLIC_API_URL=https://api.staging.fileworks.ai
#   backend/.env.prod     STRIPE_SECRET_KEY=sk_live_...
#                         PUBLIC_APP_URL=https://fileworks.ai
#                         PUBLIC_API_URL=https://api.fileworks.ai
# PUBLIC_API_URL is the browser-facing API origin (Cloudflare → Lambda URL).
# `fw frontend` prefers it over the raw Function URL when writing config.js.
# Local webhook (optional): stripe listen --forward-to localhost:8000/api/billing/webhook
# Events: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted
