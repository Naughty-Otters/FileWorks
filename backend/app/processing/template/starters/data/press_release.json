  "variables": [
    {
      "id": "var_mt7qypk1_1367",
      "name": "release_date",
      "label": "Press release date",
      "type": "date",
      "sampleValue": "March 25, 2026"
    },
    {
      "id": "var_mt7qypk1_1368",
      "name": "city_state",
      "label": "Dateline city and state",
      "type": "text",
      "sampleValue": "San Francisco, CA"
    },
    {
      "id": "var_mt7qypk1_1369",
      "name": "headline",
      "label": "Press release headline",
      "type": "text",
      "sampleValue": "Acme Studio Expands Fillable Design Library for Business Documents"
    },
    {
      "id": "var_mt7qypk1_1370",
      "name": "subhead",
      "label": "Press release subhead",
      "type": "text",
      "sampleValue": "New starters help teams turn converted files into agreements, plans, proposals, and more"
    },
    {
      "id": "var_mt7qypk1_1371",
      "name": "lead_paragraph",
      "label": "Opening paragraph of the release",
      "type": "text",
      "sampleValue": "Acme Studio today announced a major expansion of its Design studio starters, adding popular business document types with ready-made variables for AI-assisted fill."
    },
    {
      "id": "var_mt7qypk1_1372",
      "name": "body_paragraph",
      "label": "Supporting body paragraph",
      "type": "text",
      "sampleValue": "The update covers agreements, plans, policies, forms, checklists, letters, proposals, reports, notices, memos, and press releases—so operators can go from PDF to polished output without rebuilding layouts."
    },
    {
      "id": "var_mt7qypk1_1373",
      "name": "quote_text",
      "label": "Executive quote text",
      "type": "text",
      "sampleValue": "Customers asked for the same document types they already use to run the business. Now those layouts are one click away."
    },
    {
      "id": "var_mt7qypk1_1374",
      "name": "quote_attribution",
      "label": "Quote attribution name and title",
      "type": "text",
      "sampleValue": "Alex Rivera, Head of Product, Acme Studio"
    },
    {
      "id": "var_mt7qypk1_1375",
      "name": "closing_paragraph",
      "label": "Closing paragraph before boilerplate",
      "type": "text",
      "sampleValue": "The starters are available now in the Designs library for workspace and API customers."
    },
    {
      "id": "var_mt7qypk1_1376",
      "name": "company_name",
      "label": "Company name in the boilerplate",
      "type": "text",
      "sampleValue": "Acme Studio"
    },
    {
      "id": "var_mt7qypk1_1377",
      "name": "company_boilerplate",
      "label": "About-the-company boilerplate",
      "type": "text",
      "sampleValue": "Acme Studio helps teams convert documents and produce branded outputs with AI reading, translation, and fillable designs."
    },
    {
      "id": "var_mt7qypk1_1378",
      "name": "media_contact_name",
      "label": "Media contact name",
      "type": "text",
      "sampleValue": "Riley Ortiz"
    },
    {
      "id": "var_mt7qypk1_1379",
      "name": "media_contact_email",
      "label": "Media contact email",
      "type": "text",
      "sampleValue": "press@acme.example"
    },
